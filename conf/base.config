// Default resources. Override per site in a custom config (-c my.config).
process {
    cpus   = 2
    memory = 8.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'terminate' }
    maxRetries    = 1

    withName: 'GUPPY_BASECALL' {        // GPU; ~10-12 h for ~200 GB fast5
        cpus   = { params.cpu ? 32 : 8 } // --cpu: guppy CPU build, far slower
        memory = 32.GB
        time   = 48.h
    }
    withName: 'GUPPY_BARCODE' {
        cpus   = 16
        memory = 16.GB
        time   = 8.h
    }
    withName: 'MINIMAP2_ALIGN' {
        cpus   = 16
        memory = 32.GB
        time   = 8.h
    }
    withName: 'NANOPOLISH_METHYL' {
        cpus   = 16
        memory = 32.GB
        time   = 24.h
    }
    withName: 'READ_INFOS|METHYL_STATS' {
        cpus   = 1
        memory = 8.GB
    }
    withName: 'PREPARE_REFERENCE' {
        cpus   = 1
        memory = 4.GB
    }
}
