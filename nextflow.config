manifest {
    name            = 'fiberseq-cpg-r9-nf'
    description     = 'R9.4.1 fast5: guppy basecalling + demultiplexing, minimap2 alignment, nanopolish CpG methylation calls'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.0.0'
}

params {
    // input
    fast5_dir       = null          // raw fast5 of one run (not demultiplexed); searched recursively
    basecalled_dir  = null          // optional: existing guppy output (pass/ + sequencing_summary.txt) -> skip basecalling
    basecall_only   = false         // GPU-only run: stop after guppy basecalling (copy outdir/basecaller to the CPU side)
    reference       = "${projectDir}/assets/S288C_R64-4-1_genome_roman_chr.fa"   // yeast S288C R64-4-1
    outdir          = 'results'
    publish_mode    = 'copy'

    // guppy basecaller (GPU)
    guppy_config    = 'dna_r9.4.1_450bps_hac.cfg'
    guppy_device    = 'auto'        // 'auto' / 'cuda:0' / 'cuda:all'
    cpu             = false         // basecall with the guppy CPU build instead of the GPU (very slow)
    guppy_args      = '--gpu_runners_per_device 32'

    // guppy barcoder (CPU)
    barcode_kits    = 'EXP-NBD104 EXP-NBD114'
    barcoder_args   = ''
    barcodes        = 'all'         // 'all' or e.g. 'barcode01,barcode02'
    min_reads       = 1000          // with barcodes='all': skip barcodes with fewer reads

    // alignment filter
    min_mapq          = 30
    sam_exclude_flags = 2052        // unmapped + supplementary

    // nanopolish call-methylation motif: cpg, gpc, dam, dcm
    motif           = 'cpg'
    call_threshold  = 2.5           // |log-likelihood ratio| for methylated / ambiguous calls

    // Apptainer/Singularity image, built from containers/fiberseq-cpg-r9.def
    container       = "${projectDir}/containers/fiberseq-cpg-r9_v0.0.0.sif"
    bind            = null          // extra bind paths, e.g. '/mnt/data1' (fast5 symlinks pointing elsewhere)

    // Slurm
    slurm_queue     = null          // CPU partition, e.g. 'slim18'
    slurm_gpu_queue = null          // GPU partition
    slurm_gpu_opts  = '--gres=gpu:1'
}

// Task folders under --outdir, not the launch directory (-w still overrides).
// .nextflow/ (resume cache) and .nextflow.log can only be moved by env vars,
// set by the templates: NXF_CACHE_DIR, NXF_LOG_FILE.
workDir = "${params.outdir}/work"

includeConfig 'conf/base.config'

process.container = params.container

profiles {
    local {
        process.executor = 'local'
    }

    slurm {
        process {
            executor = 'slurm'
            queue    = params.slurm_queue
            withLabel: 'gpu' {
                queue          = { params.cpu ? params.slurm_queue : (params.slurm_gpu_queue ?: params.slurm_queue) }
                clusterOptions = { params.cpu ? null : params.slurm_gpu_opts }
            }
        }
        executor {
            queueSize       = 50
            submitRateLimit = '10/1min'
        }
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.envWhitelist = 'CUDA_VISIBLE_DEVICES'   // GPU assigned by Slurm reaches guppy
        apptainer.runOptions = params.bind ? "-B ${params.bind}" : ''
        process {
            withLabel: 'gpu' { containerOptions = { params.cpu ? '' : '--nv' } }
        }
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.envWhitelist = 'CUDA_VISIBLE_DEVICES'   // GPU assigned by Slurm reaches guppy
        singularity.runOptions = params.bind ? "-B ${params.bind}" : ''
        process {
            withLabel: 'gpu' { containerOptions = { params.cpu ? '' : '--nv' } }
        }
    }

    // tools from PATH / Lmod modules, no container
    nocontainer {
        process.container = null
    }

    // wiring check without tools or data: -profile test,local -stub
    test {
        params.fast5_dir = "${projectDir}/assets"
        params.outdir    = 'results_test'
        process.container = null
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
